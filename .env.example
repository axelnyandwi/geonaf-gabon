# Dossier de données optionnel, relatif à la racine du projet ou absolu.
# À définir dans le terminal ; les fichiers .env ne sont pas chargés automatiquement.
GABON_GEOAI_DATA_DIR=data

# Base PostgreSQL/PostGIS facultative (docs/database_connection.md). Sans ces variables,
# l'application reste sur le stockage fichier. Ne jamais versionner une vraie valeur.
# GEONAF_DB_BACKEND=file
# GEONAF_DB_ENV=dev
# GEONAF_DATABASE_URL=postgresql+psycopg://postgres.<ref>:<mot-de-passe-encodé>@aws-0-<région>.pooler.supabase.com:5432/postgres
